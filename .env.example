# Supabase Connect > Session pooler (port 5432).
# Replace the placeholders; URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST_POOLER:5432/postgres"

# Optional migration URL: Supabase Session pooler (5432) or direct connection.
# If omitted, the Prisma CLI uses DATABASE_URL.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST_POOLER:5432/postgres"
